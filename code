        class App {
            constructor() {
                this.db = null;
                this.auth = null;
                this.user = null;
                this.isCoachMode = false;

                this.state = {
                    users: [
                        { id: 'sarah', name: 'Sarah M.', joined: '2026-01-10', pin: '' },
                        { id: 'jess', name: 'Jess K.', joined: '2026-01-12', pin: '' },
                        { id: 'amanda', name: 'Amanda R.', joined: '2026-01-15', pin: '' },
                        { id: 'elena', name: 'Elena T.', joined: '2026-02-01', pin: '' }
                    ],
                    exercises: [...INITIAL_EXERCISES],
                    logs: [],
                    measurements: [],
                    assignedWorkout: { date: '', exerciseIds: [], note: '' }
                };

                this.currentUser = null;
                this.currentView = 'welcome';
                this.selectedExerciseId = null;

                this.initFirebase();
            }

            async initFirebase() {
                if (firebaseConfig) {
                    try {
                        const app = initializeApp(firebaseConfig);
                        this.auth = getAuth(app);
                        this.db = getFirestore(app);

                        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                            await signInWithCustomToken(this.auth, __initial_auth_token);
                        } else {
                            await signInAnonymously(this.auth);
                        }

                        onAuthStateChanged(this.auth, (u) => {
                            if (u) {
                                this.user = u;
                                this.setupRealtimeListeners();
                            }
                        });
                    } catch (e) {
                        console.error("Firestore initialization error, running in offline mode:", e);
                        this.loadLocalState();
                    }
                } else {
                    this.loadLocalState();
                }
                this.render();
            }

            loadLocalState() {
                const saved = localStorage.getItem('iron_sisters_data');
                if (saved) {
                    try { 
                        const parsed = JSON.parse(saved);
                        this.state = { ...this.state, ...parsed }; 
                        if (!parsed.exercises || parsed.exercises.length < INITIAL_EXERCISES.length) {
                            this.state.exercises = INITIAL_EXERCISES;
                        }
                    } catch(e){}
                }
            }

            saveLocalState() {
                localStorage.setItem('iron_sisters_data', JSON.stringify(this.state));
            }

            setupRealtimeListeners() {
                if (!this.db) return;

                const publicDocRef = doc(this.db, 'artifacts', appId, 'public', 'data', 'app_state');
                onSnapshot(publicDocRef, (snapshot) => {
                    if (snapshot.exists()) {
                        const data = snapshot.data();
                        this.state.logs = data.logs || [];
                        this.state.exercises = (data.exercises && data.exercises.length >= INITIAL_EXERCISES.length) ? data.exercises : INITIAL_EXERCISES;
                        this.state.users = data.users || this.state.users;
                        this.state.measurements = data.measurements || [];
                        this.state.assignedWorkout = data.assignedWorkout || { date: '', exerciseIds: [], note: '' };
                        this.render();
                    } else {
                        setDoc(publicDocRef, {
                            logs: [],
                            exercises: INITIAL_EXERCISES,
                            users: this.state.users,
                            measurements: [],
                            assignedWorkout: { date: '', exerciseIds: [], note: '' }
                        }, { merge: true });
                    }
                }, (err) => console.error("Firestore sync error:", err));
            }

            async syncToFirestore() {
                if (!this.db || !this.user) {
                    this.saveLocalState();
                    return;
                }
                const publicDocRef = doc(this.db, 'artifacts', appId, 'public', 'data', 'app_state');
                try {
                    await setDoc(publicDocRef, {
                        logs: this.state.logs,
                        exercises: this.state.exercises,
                        users: this.state.users,
                        measurements: this.state.measurements,
                        assignedWorkout: this.state.assignedWorkout
                    }, { merge: true });
                } catch(e) {
                    console.error("Error saving data to cloud:", e);
                }
            }

            toggleCoachMode() {
                this.isCoachMode = !this.isCoachMode;
                const btn = document.getElementById('coach-toggle-btn');
                if (this.isCoachMode) {
                    btn.classList.add('bg-amber-500', 'text-slate-900', 'font-bold');
                    btn.classList.remove('bg-amber-500/20', 'text-amber-300');
                    this.showModal('Coach Mode Active 👑', 'You can now push workouts, add custom exercises, and monitor group activity.');
                } else {
                    btn.classList.remove('bg-amber-500', 'text-slate-900', 'font-bold');
                    btn.classList.add('bg-amber-500/20', 'text-amber-300');
                }
                this.render();
            }

            navigate(view, param = null) {
                this.currentView = view;
                this.selectedExerciseId = param;
                this.render();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            goHome() {
                if (!this.currentUser) {
                    this.navigate('welcome');
                } else {
                    this.navigate('dashboard');
                }
            }

            promptUserLogin(userId) {
                const targetUser = this.state.users.find(u => u.id === userId);
                if (!targetUser) return;

                if (targetUser.pin) {
                    this.showPinModal(targetUser);
                } else {
                    this.login(targetUser.id);
                }
            }

            showPinModal(targetUser) {
                const modal = document.getElementById('modal-container');
                const content = document.getElementById('modal-content');
                content.innerHTML = `
                    <h3 class="text-lg font-bold text-white mb-1"><i class="fa-solid fa-lock text-pink-400 mr-2"></i>Enter Security PIN</h3>
                    <p class="text-slate-400 text-xs mb-4">Profile locked for <b>${targetUser.name}</b></p>
                    <form onsubmit="event.preventDefault(); app.verifyPin('${targetUser.id}', this.pinInput.value);">
                        <input type="password" maxlength="4" name="pinInput" placeholder="4-digit PIN" autofocus required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-center text-xl tracking-widest text-white mb-4 focus:outline-none focus:border-pink-500">
                        <div class="flex space-x-2">
                            <button type="button" onclick="app.closeModal()" class="flex-1 bg-slate-700 text-slate-300 font-semibold py-2.5 rounded-xl text-sm">Cancel</button>
                            <button type="submit" class="flex-1 bg-gradient-to-r from-pink-500 to-purple-600 text-white font-semibold py-2.5 rounded-xl text-sm shadow-lg shadow-pink-500/20">Unlock</button>
                        </div>
                    </form>
                `;
                modal.classList.remove('hidden');
            }

            verifyPin(userId, enteredPin) {
                const targetUser = this.state.users.find(u => u.id === userId);
                if (targetUser && targetUser.pin === enteredPin) {
                    this.closeModal();
                    this.login(userId);
                } else {
                    this.showModal('Incorrect PIN 🔒', 'The PIN entered is incorrect. Please try again.');
                }
            }

            setUserPin(newPin) {
                if (newPin.length > 0 && newPin.length !== 4) {
                    this.showModal('Invalid PIN', 'PIN must be exactly 4 digits (or leave blank to disable).');
                    return;
                }
                const u = this.state.users.find(usr => usr.id === this.currentUser.id);
                if (u) {
                    u.pin = newPin;
                    this.currentUser.pin = newPin;
                    this.syncToFirestore();
                    this.showModal('Security Updated 🔒', newPin ? '4-digit PIN lock activated for your profile.' : 'PIN protection removed.');
                }
            }

            login(userId) {
                this.currentUser = this.state.users.find(u => u.id === userId);
                document.getElementById('header-user-info').classList.remove('hidden');
                document.getElementById('current-user-badge').innerText = this.currentUser.name;
                this.navigate('dashboard');
            }

            logout() {
                this.currentUser = null;
                this.isCoachMode = false;
                document.getElementById('header-user-info').classList.add('hidden');
                document.getElementById('header-subtitle').innerText = 'Strength Tracker';
                this.navigate('welcome');
            }

            addNewUser(name, pin = '') {
                if (!name.trim()) return;
                const newId = name.toLowerCase().replace(/[^a-z0-9]/g, '_') + '_' + Math.floor(Math.random() * 1000);
                const newUser = { id: newId, name: name.trim(), joined: new Date().toISOString().split('T')[0], pin: pin };
                this.state.users.push(newUser);
                this.syncToFirestore();
                this.login(newId);
            }

            addNewExercise(name, category, trackType, unit) {
                if (!name.trim()) return;
                const newId = name.toLowerCase().replace(/[^a-z0-9]/g, '_');
                if (this.state.exercises.some(e => e.id === newId)) {
                    this.showModal('Notice', 'An exercise with this name already exists.');
                    return;
                }
                this.state.exercises.push({ id: newId, name: name.trim(), category: category, trackType: trackType, defaultUnit: unit });
                this.syncToFirestore();
                this.showModal('Exercise Added! 💪', `"${name.trim()}" is now available for everyone in the group.`);
                this.navigate('dashboard');
            }

            logWorkout(exerciseId, weight, performanceValue, notes) {
                if (performanceValue === '') {
                    this.showModal('Missing Info', 'Please enter your reps or time completed.');
                    return;
                }

                const userLogs = this.state.logs.filter(l => l.userId === this.currentUser.id && l.exerciseId === exerciseId);
                const ex = this.state.exercises.find(e => e.id === exerciseId);
                
                const numWeight = weight ? parseFloat(weight) : 0;
                const previousMaxWeight = userLogs.length > 0 ? Math.max(...userLogs.map(l => l.weight || 0)) : 0;
                const isPR = (previousMaxWeight > 0 && numWeight > previousMaxWeight) || (previousMaxWeight === 0 && numWeight > 0 && userLogs.length > 0);

                const entry = {
                    id: 'log_' + Date.now(),
                    userId: this.currentUser.id,
                    exerciseId: exerciseId,
                    weight: numWeight,
                    performanceValue: performanceValue,
                    date: new Date().toISOString().split('T')[0],
                    notes: notes || '',
                    isPR: isPR
                };

                this.state.logs.unshift(entry);
                this.syncToFirestore();
                
                if (isPR) {
                    this.showModal('NEW PERSONAL RECORD! 🎉🏆', `Amazing job! You smashed your previous best weight!`);
                } else {
                    this.showModal('Success! 💪', 'Workout logged successfully!', true);
                }
                this.render();
            }

            pushWorkout(selectedIds, note) {
                this.state.assignedWorkout = {
                    date: new Date().toISOString().split('T')[0],
                    exerciseIds: selectedIds,
                    note: note || ''
                };
                this.syncToFirestore();
                this.showModal('Workout Pushed! 🚀', 'This workout is now pinned to top for all participants.');
                this.navigate('dashboard');
            }

            clearAssignedWorkout() {
                this.state.assignedWorkout = { date: '', exerciseIds: [], note: '' };
                this.syncToFirestore();
                this.render();
            }

            logMeasurements(weight, waist, hips, thighs, arms) {
                const entry = {
                    id: 'meas_' + Date.now(),
                    userId: this.currentUser.id,
                    date: new Date().toISOString().split('T')[0],
                    weight: weight ? parseFloat(weight) : null,
                    waist: waist ? parseFloat(waist) : null,
                    hips: hips ? parseFloat(hips) : null,
                    thighs: thighs ? parseFloat(thighs) : null,
                    arms: arms ? parseFloat(arms) : null
                };
                this.state.measurements.unshift(entry);
                this.syncToFirestore();
                this.showModal('Success! 📊', 'Body measurements recorded!', true);
                this.navigate('dashboard');
            }

            calculatePersonalRecord(userId, exerciseId) {
                const userLogs = this.state.logs.filter(l => l.userId === userId && l.exerciseId === exerciseId);
                if (userLogs.length === 0) return null;
                return userLogs.reduce((max, log) => (log.weight || 0) > (max.weight || 0) ? log : max, userLogs[0]);
            }

            showModal(title, message, autoClose = false) {
                const modal = document.getElementById('modal-container');
                const content = document.getElementById('modal-content');
                content.innerHTML = `
                    <h3 class="text-lg font-bold text-white mb-2">${title}</h3>
                    <p class="text-slate-300 text-sm mb-6">${message}</p>
                    <button onclick="app.closeModal()" class="w-full bg-gradient-to-r from-pink-500 to-purple-600 text-white font-semibold py-2.5 rounded-xl shadow-lg shadow-pink-500/20 hover:opacity-90 transition-opacity">Got it</button>
                `;
                modal.classList.remove('hidden');
                if (autoClose) {
                    setTimeout(() => this.closeModal(), 1500);
                }
            }

            closeModal() {
                document.getElementById('modal-container').classList.add('hidden');
            }

            render() {
                const container = document.getElementById('app-container');
                
                if (this.currentView === 'welcome') {
                    document.getElementById('header-subtitle').innerText = 'Strength Tracker';
                    container.innerHTML = this.renderWelcomeView();
                } else if (this.currentView === 'dashboard') {
                    document.getElementById('header-subtitle').innerText = 'Workout Hub';
                    container.innerHTML = this.renderDashboardView();
                } else if (this.currentView === 'coach_push') {
                    document.getElementById('header-subtitle').innerText = 'Coach Builder';
                    container.innerHTML = this.renderCoachPushView();
                } else if (this.currentView === 'exercise_detail') {
                    document.getElementById('header-subtitle').innerText = 'Progress Chart';
                    container.innerHTML = this.renderExerciseDetailView();
                    this.initChart();
                } else if (this.currentView === 'measurements') {
                    document.getElementById('header-subtitle').innerText = 'Body Progress';
                    container.innerHTML = this.renderMeasurementsView();
                } else if (this.currentView === 'add_exercise') {
                    document.getElementById('header-subtitle').innerText = 'New Exercise';
                    container.innerHTML = this.renderAddExerciseView();
                } else if (this.currentView === 'security') {
                    document.getElementById('header-subtitle').innerText = 'Profile Security';
                    container.innerHTML = this.renderSecurityView();
                } else if (this.currentView === 'group_summary') {
                    document.getElementById('header-subtitle').innerText = 'Group Progress';
                    container.innerHTML = this.renderGroupSummaryView();
                }
            }

            renderWelcomeView() {
                let usersHtml = this.state.users.map(u => `
                    <button onclick="app.promptUserLogin('${u.id}')" class="w-full text-left bg-slate-800 hover:bg-slate-750 border border-slate-700/80 hover:border-pink-500/50 p-4 rounded-2xl flex items-center justify-between group transition-all shadow-sm hover:shadow-pink-500/10">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-pink-500/20 to-purple-500/20 border border-pink-500/30 flex items-center justify-center text-pink-400 font-bold group-hover:scale-105 transition-transform">
                                ${u.name.charAt(0)}
                            </div>
                            <div>
                                <div class="flex items-center space-x-1.5">
                                    <span class="font-semibold text-white block group-hover:text-pink-300 transition-colors">${u.name}</span>
                                    ${u.pin ? `<i class="fa-solid fa-lock text-[10px] text-amber-400" title="PIN Protected"></i>` : ''}
                                </div>
                                <span class="text-xs text-slate-400">Member since ${u.joined}</span>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-slate-500 group-hover:text-pink-400 transition-colors"></i>
                    </button>
                `).join('');

                return `
                    <div class="space-y-6 pt-2">
                        <div class="text-center space-y-2 py-4">
                            <div class="inline-flex p-3 bg-gradient-to-tr from-pink-500 to-purple-600 rounded-2xl text-white shadow-xl shadow-pink-500/20 mb-2">
                                <i class="fa-solid fa-fire-flame-curved text-2xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold tracking-tight">Who is lifting today?</h2>
                            <p class="text-sm text-slate-400">Select your profile to start logging your weights.</p>
                        </div>
                        
                        <div class="space-y-3">
                            ${usersHtml}
                        </div>

                        <div class="pt-4 border-t border-slate-800">
                            <form onsubmit="event.preventDefault(); app.addNewUser(this.newUserName.value, this.newUserPin.value);" class="space-y-3">
                                <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">New Participant</label>
                                <div class="space-y-2">
                                    <input type="text" name="newUserName" placeholder="Enter your name..." required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-pink-500">
                                    <div class="flex space-x-2">
                                        <input type="password" maxlength="4" name="newUserPin" placeholder="4-Digit PIN (Optional)" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-pink-500">
                                        <button type="submit" class="bg-gradient-to-r from-pink-500 to-purple-600 text-white px-5 rounded-xl text-sm font-semibold shadow-lg shadow-pink-500/20 hover:opacity-90 transition-opacity whitespace-nowrap">
                                            Join Group
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                `;
            }

            renderDashboardView() {
                let userLogs = this.state.logs.filter(l => l.userId === this.currentUser.id);
                const assigned = this.state.assignedWorkout;
                const isAssignedActive = assigned && assigned.exerciseIds && assigned.exerciseIds.length > 0;

                let sortedExercises = [...this.state.exercises].sort((a, b) => {
                    const aAssigned = isAssignedActive && assigned.exerciseIds.includes(a.id);
                    const bAssigned = isAssignedActive && assigned.exerciseIds.includes(b.id);
                    if (aAssigned && !bAssigned) return -1;
                    if (!aAssigned && bAssigned) return 1;
                    return a.name.localeCompare(b.name);
                });

                let exercisesHtml = sortedExercises.map(ex => {
                    const lastLog = userLogs.find(l => l.exerciseId === ex.id);
                    const isTodayFocus = isAssignedActive && assigned.exerciseIds.includes(ex.id);
                    const pr = this.calculatePersonalRecord(this.currentUser.id, ex.id);
                    const isTimeTracked = ex.trackType === 'time';

                    return `
                        <div class="bg-slate-800 border ${isTodayFocus ? 'border-pink-500/60 ring-1 ring-pink-500/30' : 'border-slate-700/80'} rounded-2xl p-4 space-y-3 shadow-sm hover:border-slate-600 transition-all">
                            <div class="flex items-center justify-between">
                                <div class="cursor-pointer flex-1" onclick="app.navigate('exercise_detail', '${ex.id}')">
                                    <div class="flex items-center space-x-2">
                                        <span class="text-xs font-semibold text-pink-400 uppercase tracking-wider">${ex.category}</span>
                                        <span class="text-[10px] bg-slate-700 text-slate-300 font-medium px-2 py-0.5 rounded-full uppercase">${isTimeTracked ? 'Time Based' : 'Reps Based'}</span>
                                        ${isTodayFocus ? `<span class="bg-gradient-to-r from-pink-500 to-purple-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">Today's Focus</span>` : ''}
                                    </div>
                                    <h3 class="font-bold text-white text-base hover:text-pink-300 transition-colors flex items-center">
                                        ${ex.name} <i class="fa-solid fa-chart-line ml-2 text-xs text-slate-400"></i>
                                    </h3>
                                    
                                    <!-- LAST WEIGHT & PR DISPLAY -->
                                    <div class="mt-1 flex flex-wrap items-center gap-2 text-xs">
                                        <div class="flex items-center space-x-1">
                                            <i class="fa-solid fa-clock-rotate-left text-amber-400"></i>
                                            <span class="text-slate-300 font-medium">Last:</span>
                                            ${lastLog ? `<span class="text-pink-300 font-bold bg-pink-500/10 px-2 py-0.5 rounded-md border border-pink-500/20">${lastLog.weight ? lastLog.weight + ' lbs × ' : ''}${lastLog.performanceValue || lastLog.reps || ''}</span>` : `<span class="text-slate-500 italic">None logged</span>`}
                                        </div>
                                        ${pr && pr.weight ? `
                                            <div class="flex items-center space-x-1 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded-md text-amber-300 font-bold text-[11px]">
                                                <i class="fa-solid fa-trophy text-amber-400 mr-0.5"></i> PR: ${pr.weight} lbs
                                            </div>
                                        ` : ''}
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Quick Log Form -->
                            <form onsubmit="event.preventDefault(); app.logWorkout('${ex.id}', this.weight ? this.weight.value : '', this.perf.value, this.notes.value);" class="bg-slate-900/60 p-3 rounded-xl border border-slate-700/50 space-y-3">
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <label class="block text-[10px] font-semibold text-slate-400 uppercase mb-1">Weight (lbs/kg)</label>
                                        <input type="number" step="0.5" name="weight" placeholder="${lastLog && lastLog.weight ? lastLog.weight : '0'}" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-pink-500">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-semibold text-slate-400 uppercase mb-1">${isTimeTracked ? 'Time (min:sec or sec)' : 'Reps'}</label>
                                        <input type="text" name="perf" placeholder="${isTimeTracked ? 'e.g. 1:30 or 90s' : (lastLog ? lastLog.performanceValue || lastLog.reps : '0')}" required class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-pink-500">
                                    </div>
                                </div>
                                <div class="flex items-center space-x-2">
                                    <input type="text" name="notes" placeholder="Optional notes..." class="flex-1 bg-slate-800 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-pink-500">
                                    <button type="submit" class="bg-pink-500 hover:bg-pink-600 text-white px-4 py-1.5 rounded-lg text-xs font-bold shadow-md shadow-pink-500/20 transition-all flex items-center">
                                        <i class="fa-solid fa-check mr-1.5"></i> Record
                                    </button>
                                </div>
                            </form>
                        </div>
                    `;
                }).join('');

                return `
                    <div class="space-y-5">
                        <!-- Welcome & Quick Menu Grid -->
                        <div class="bg-gradient-to-tr from-slate-800 to-slate-800/80 border border-slate-700 rounded-2xl p-4 shadow-md">
                            <div class="flex items-center justify-between mb-3">
                                <div>
                                    <span class="text-xs text-slate-400 block">Session Dashboard</span>
                                    <h2 class="text-lg font-bold text-white">Let's lift, ${this.currentUser.name}</h2>
                                </div>
                                <button onclick="app.navigate('security')" class="text-slate-400 hover:text-white text-xs p-2 bg-slate-700/50 rounded-xl border border-slate-600" title="Security Settings">
                                    <i class="fa-solid fa-shield-halved"></i>
                                </button>
                            </div>
                            <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-700/60">
                                <button onclick="app.navigate('measurements')" class="bg-slate-700/70 hover:bg-slate-700 text-pink-300 border border-slate-600/80 py-2 px-3 rounded-xl text-xs font-semibold flex items-center justify-center transition-colors">
                                    <i class="fa-solid fa-ruler-combined mr-1.5"></i> Body Progress
                                </button>
                                <button onclick="app.navigate('group_summary')" class="bg-slate-700/70 hover:bg-slate-700 text-purple-300 border border-slate-600/80 py-2 px-3 rounded-xl text-xs font-semibold flex items-center justify-center transition-colors">
                                    <i class="fa-solid fa-users mr-1.5"></i> Group Roster
                                </button>
                            </div>
                        </div>

                        <!-- Coach's Assigned Workout Broadcast Banner -->
                        ${isAssignedActive ? `
                            <div class="bg-gradient-to-r from-purple-900/40 to-pink-900/40 border border-pink-500/40 p-4 rounded-2xl space-y-2">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-bold text-pink-400 uppercase tracking-wider flex items-center">
                                        <i class="fa-solid fa-bullhorn mr-1.5"></i> Coach's Workout for Today
                                    </span>
                                    ${this.isCoachMode ? `<button onclick="app.clearAssignedWorkout()" class="text-xs text-slate-400 hover:text-red-400">Clear</button>` : ''}
                                </div>
                                <p class="text-sm font-semibold text-white">${assigned.note || 'Focus on these target lifts for today\'s session!'}</p>
                            </div>
                        ` : ''}

                        <!-- Coach Action Bar -->
                        ${this.isCoachMode ? `
                            <div class="bg-amber-500/10 border border-amber-500/30 p-3 rounded-xl flex items-center justify-between">
                                <div class="flex items-center space-x-2 text-xs text-amber-300 font-semibold">
                                    <i class="fa-solid fa-crown text-amber-400"></i>
                                    <span>Coach Portal Active</span>
                                </div>
                                <button onclick="app.navigate('coach_push')" class="bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold px-3 py-1.5 rounded-lg text-xs transition-colors">
                                    <i class="fa-solid fa-paper-plane mr-1"></i> Push Today's Workout
                                </button>
                            </div>
                        ` : ''}

                        <!-- Exercises Header -->
                        <div class="flex items-center justify-between">
                            <h3 class="font-bold text-slate-200 text-sm uppercase tracking-wider">Exercises (${this.state.exercises.length})</h3>
                            <button onclick="app.navigate('add_exercise')" class="text-xs text-pink-400 hover:text-pink-300 font-semibold flex items-center bg-slate-800 border border-slate-700 px-2.5 py-1 rounded-lg">
                                <i class="fa-solid fa-plus mr-1"></i> Add Exercise
                            </button>
                        </div>

                        <!-- Exercise Cards List -->
                        <div class="space-y-4">
                            ${exercisesHtml}
                        </div>
                    </div>
                `;
            }

            renderCoachPushView() {
                const assigned = this.state.assignedWorkout || {};
                const currentSelected = assigned.exerciseIds || [];

                let checkboxesHtml = this.state.exercises.map(ex => {
                    const isChecked = currentSelected.includes(ex.id) ? 'checked' : '';
                    return `
                        <label class="flex items-center space-x-3 bg-slate-800 border border-slate-700/70 p-3 rounded-xl cursor-pointer hover:border-pink-500/50 transition-colors">
                            <input type="checkbox" name="selectedEx" value="${ex.id}" ${isChecked} class="w-4 h-4 accent-pink-500 rounded">
                            <div>
                                <span class="font-bold text-white text-sm block">${ex.name}</span>
                                <span class="text-xs text-slate-400">${ex.category} • ${ex.trackType === 'time' ? 'Time-based' : 'Reps-based'}</span>
                            </div>
                        </label>
                    `;
                }).join('');

                return `
                    <div class="space-y-6">
                        <button onclick="app.navigate('dashboard')" class="text-xs text-slate-400 hover:text-white flex items-center">
                            <i class="fa-solid fa-arrow-left mr-1.5"></i> Back to Dashboard
                        </button>

                        <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 space-y-2">
                            <div class="flex items-center space-x-2">
                                <i class="fa-solid fa-crown text-amber-400"></i>
                                <h2 class="text-lg font-bold text-white">Push Today's Workout</h2>
                            </div>
                            <p class="text-xs text-slate-400">Select exercises for today's session. They will be highlighted and pinned to the top of everyone's app.</p>
                        </div>

                        <form onsubmit="event.preventDefault(); const selected = Array.from(this.querySelectorAll('input[name=selectedEx]:checked')).map(cb => cb.value); app.pushWorkout(selected, this.coachNote.value);" class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Coach's Message / Focus Notes</label>
                                <input type="text" name="coachNote" value="${assigned.note || ''}" placeholder="e.g. Heavy Lower Body focus! 3 sets each." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-pink-500">
                            </div>

                            <div class="space-y-2">
                                <label class="block text-xs font-semibold text-slate-400 uppercase">Select Exercises for Today</label>
                                <div class="space-y-2 max-h-96 overflow-y-auto pr-1">
                                    ${checkboxesHtml}
                                </div>
                            </div>

                            <button type="submit" class="w-full bg-gradient-to-r from-amber-500 to-pink-500 text-slate-900 font-bold py-3 rounded-xl text-sm shadow-lg hover:opacity-90 transition-opacity">
                                <i class="fa-solid fa-paper-plane mr-2"></i> Broadcast Workout to Group
                            </button>
                        </form>
                    </div>
                `;
            }

            renderExerciseDetailView() {
                const ex = this.state.exercises.find(e => e.id === this.selectedExerciseId);
                const userLogs = this.state.logs.filter(l => l.userId === this.currentUser.id && l.exerciseId === ex.id);

                let historyHtml = userLogs.length === 0 ? 
                    `<p class="text-xs text-slate-400 text-center py-4">No logged history for this exercise yet.</p>` :
                    userLogs.map(l => `
                        <div class="bg-slate-800 border ${l.isPR ? 'border-amber-500/50 bg-amber-500/5' : 'border-slate-700/60'} rounded-xl p-3 flex items-center justify-between text-sm">
                            <div>
                                <div class="flex items-center space-x-2">
                                    <span class="font-bold text-white">${l.weight ? l.weight + ' lbs × ' : ''}${l.performanceValue || l.reps || ''}</span>
                                    ${l.isPR ? `<span class="text-[10px] bg-amber-500/20 text-amber-300 font-bold px-1.5 py-0.5 rounded">PR</span>` : ''}
                                </div>
                                <span class="text-xs text-slate-400 block">${l.date} ${l.notes ? '• ' + l.notes : ''}</span>
                            </div>
                        </div>
                    `).join('');

                return `
                    <div class="space-y-6">
                        <button onclick="app.navigate('dashboard')" class="text-xs text-slate-400 hover:text-white flex items-center">
                            <i class="fa-solid fa-arrow-left mr-1.5"></i> Back to Exercises
                        </button>

                        <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 space-y-2">
                            <span class="text-xs font-semibold text-pink-400 uppercase tracking-wider">${ex.category} • ${ex.trackType === 'time' ? 'Time Tracked' : 'Rep Tracked'}</span>
                            <h2 class="text-xl font-bold text-white">${ex.name}</h2>
                            <p class="text-xs text-slate-400">Progress chart showing your performance over time.</p>
                        </div>

                        <!-- Chart Container -->
                        <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4">
                            <div class="h-64 relative">
                                <canvas id="progressChart"></canvas>
                            </div>
                        </div>

                        <!-- History Section -->
                        <div class="space-y-3">
                            <h3 class="font-bold text-slate-300 text-sm uppercase tracking-wider">Workout History</h3>
                            <div class="space-y-2">
                                ${historyHtml}
                            </div>
                        </div>
                    </div>
                `;
            }

            initChart() {
                const ex = this.state.exercises.find(e => e.id === this.selectedExerciseId);
                const userLogs = this.state.logs
                    .filter(l => l.userId === this.currentUser.id && l.exerciseId === ex.id)
                    .sort((a, b) => new Date(a.date) - new Date(b.date));

                const ctx = document.getElementById('progressChart').getContext('2d');
                
                const labels = userLogs.map(l => l.date);
                const data = userLogs.map(l => l.weight || parseFloat(l.performanceValue) || 0);

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: `Weight / Value`,
                            data: data,
                            borderColor: '#ec4899',
                            backgroundColor: 'rgba(236, 72, 153, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.3,
                            pointBackgroundColor: '#ec4899',
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: {
                                grid: { color: 'rgba(255, 255, 255, 0.05)' },
                                ticks: { color: '#94a3b8', font: { size: 10 } }
                            },
                            y: {
                                grid: { color: 'rgba(255, 255, 255, 0.05)' },
                                ticks: { color: '#94a3b8', font: { size: 10 } }
                            }
                        }
                    }
                });
            }

            renderMeasurementsView() {
                let userMeasurements = this.state.measurements.filter(m => m.userId === this.currentUser.id);
                
                let historyHtml = userMeasurements.length === 0 ?
                    `<p class="text-xs text-slate-400 text-center py-4">No measurements recorded yet.</p>` :
                    userMeasurements.map(m => `
                        <div class="bg-slate-800 border border-slate-700/60 rounded-xl p-3 space-y-1 text-sm">
                            <div class="flex justify-between font-bold text-white border-b border-slate-700/50 pb-1">
                                <span>${m.date}</span>
                                <span>${m.weight ? m.weight + ' lbs' : ''}</span>
                            </div>
                            <div class="grid grid-cols-4 gap-2 pt-1 text-xs text-slate-300">
